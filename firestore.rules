rules_version = '2';
// قواعد حماية قاعدة بيانات حملة «مش بس شهادة»
// - الورش وفرص التدريب: يقرأها الكل، وتعدّلها المسؤولة فقط.
// - نتائج الاختبار والتسجيلات: الزوار يضيفون فقط، والمسؤولة وحدها تقرأ.
// - التسجيل بورشة يزيد عدّاد مقاعدها بواحد بنفس اللحظة، ويُرفض إذا اكتمل العدد أو التسجيل مسكّر.
// استبدلي ADMIN_UID_HERE بالـ User UID من Firebase Console › Authentication › Users.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid == "ADMIN_UID_HERE";
    }

    match /workshops/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registered'])
        && request.resource.data.registered == resource.data.get('registered', 0) + 1
        && resource.data.get('open', true) == true
        && resource.data.get('active', true) == true
        && (resource.data.get('seats', 0) == 0 || resource.data.get('registered', 0) < resource.data.get('seats', 0))
      );
    }

    match /opportunities/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /results/{id} {
      allow create: if request.resource.data.keys().hasOnly(['total', 'skills', 'band', 'v', 'createdAt'])
        && request.resource.data.total is int
        && request.resource.data.total >= 0 && request.resource.data.total <= 24
        && request.resource.data.skills is list && request.resource.data.skills.size() == 6
        && request.resource.data.band in ['start', 'mid', 'near']
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
    }

    match /registrations/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'workshop', 'workshopName', 'status', 'consent', 'v', 'createdAt'])
        && request.resource.data.consent == true
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 70
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 7 && request.resource.data.phone.size() <= 20
        && request.resource.data.email is string && request.resource.data.email.size() <= 110
        && request.resource.data.workshopName is string && request.resource.data.workshopName.size() <= 80
        && request.resource.data.status in ['student', 'graduate']
        && request.resource.data.createdAt == request.time
        // الورشة لازم تكون موجودة، والعدّاد لازم يزيد بنفس العملية
        && exists(/databases/$(database)/documents/workshops/$(request.resource.data.workshop))
        && getAfter(/databases/$(database)/documents/workshops/$(request.resource.data.workshop)).data.registered
           == get(/databases/$(database)/documents/workshops/$(request.resource.data.workshop)).data.get('registered', 0) + 1;
      allow read, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
